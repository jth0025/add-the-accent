# Copy to .env.local for local dev, and set the same variable in your
# Vercel project's Environment Variables for production/preview.
#
# The contact form (components/ContactButton.jsx) posts here; Formspree
# relays it to info@addtheaccent.com. Get this URL by creating a form at
# https://formspree.io — see README for the full one-time setup.
NEXT_PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/your-form-id
