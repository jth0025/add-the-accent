# Copy to .env.local for local dev, and set the same variable in your
# Vercel project's Environment Variables for production/preview.
#
# The contact form (components/ContactButton.jsx) posts here; Formspree
# relays it to info@addtheaccent.com. Get this URL by creating a form at
# https://formspree.io — see README for the full one-time setup.
NEXT_PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/your-form-id

# Accent Notes signups (components/AccentNotesSignup.jsx). Create a SECOND
# form (Formspree, or a list provider's form endpoint) just for the
# subscriber list and put its URL here, so subscribers are collected
# separately from contact and inquiry messages. If this is left unset,
# signups use the shared endpoint above, tagged list=accent-notes-subscribers.
NEXT_PUBLIC_SUBSCRIBE_ENDPOINT=https://formspree.io/f/your-subscriber-form-id
